# ==========================================
# .NET / C# 标准忽略文件（官方通用版）
# ==========================================

# 编译输出目录（bin、obj 是编译生成的文件，绝对不要提交）
[Bb]in/
[Oo]bj/
[Rr]elease/
[Dd]ebug/
x64/
x86/
publish/
out/

# NuGet 包（还原即可，不用提交）
**/packages/
**/node_modules/
*.nupkg
*.snupkg
*.nuspec

# 日志文件
*.log
*.log.*
logs/
Logs/

# 测试结果
TestResult.xml
TestResults/
*.trx

# 用户配置、IDE 临时文件
.vs/
.idea/
*.user
*.useross
*.suo
*.sln.docstates
*.ide/
.vscode/
.angular/

# 工具/缓存/临时文件
*.dotCover
*.OpenCover
*.coverlet
*.tmp
*.temp
*.cache
*.pidc
*.lock.json

# 发布文件
appsettings.Development.json
appsettings.*.json
!appsettings.json

# 数据库相关
*.mdf
*.ldf
*.db
*.sqlite

# 证书、密钥
*.pfx
*.key
*.publishsettings
*.pubxml
*.pubxml.user

# 操作系统文件
.DS_Store
Thumbs.db